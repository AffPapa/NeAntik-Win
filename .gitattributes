# Keep source diffs stable across Windows and GitHub.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.svg text eol=lf
*.json text eol=lf
*.js text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.gn text eol=lf
*.gni text eol=lf
*.patch text eol=lf
*.diff text eol=lf
core/native/LICENSE text eol=lf

# Binary visual assets must not be line-ending converted.
*.ico binary
*.png binary
