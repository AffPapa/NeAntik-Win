+// Copyright 2026 The NeAntik Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_NEANTIK_CANVAS_READBACK_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_NEANTIK_CANVAS_READBACK_H_
+
+#include <cstdint>
+#include "base/memory/scoped_refptr.h"
+#include "third_party/blink/renderer/platform/platform_export.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+
+namespace blink {
+class StaticBitmapImage;
+// Only opaque sRGB uint8 RGB values are projected. Alpha, non-opaque pixels,
+// unsupported colour spaces/formats and padding are preserved. Calling twice
+// at the same absolute coordinates is idempotent; the caller owns the pixels.
+PLATFORM_EXPORT void ApplyNeAntikCanvasReadback(const SkPixmap& pixmap,
+                                              int origin_x,
+                                              int origin_y,
+                                              uint64_t seed);
+// Returns a private serialization snapshot; never changes drawing resources.
+// Null indicates readback/allocation failure. Without a persona, no copy occurs.
+PLATFORM_EXPORT scoped_refptr<StaticBitmapImage> NeAntikCanvasExportSnapshot(
+    scoped_refptr<StaticBitmapImage> image);
+}  // namespace blink
+#endif
