diff --git a/third_party/blink/web_tests/neantik/canvas-readback.html b/third_party/blink/web_tests/neantik/canvas-readback.html
new file mode 100644
--- /dev/null
+++ b/third_party/blink/web_tests/neantik/canvas-readback.html
@@ -0,0 +1,72 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>NeAntik native canvas readback invariants</title>
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<script>
+function paint(c) {
+  const ctx = c.getContext('2d', {willReadFrequently: true});
+  ctx.fillStyle = 'rgb(43,87,131)';
+  ctx.fillRect(0, 0, c.width, c.height);
+  ctx.fillStyle = 'rgb(198,146,72)';
+  ctx.fillRect(2, 3, 9, 7);
+  return ctx;
+}
+function canvas() { const c = document.createElement('canvas'); c.width=32; c.height=24; return c; }
+function pixels(ctx) { return Array.from(ctx.getImageData(0,0,32,24).data); }
+test(() => {
+  const ctx=paint(canvas()); const first=pixels(ctx);
+  for(let i=0;i<10;i++) assert_array_equals(pixels(ctx),first);
+  const region=ctx.getImageData(4,5,7,8).data;
+  for(let y=0;y<8;y++) for(let x=0;x<7;x++) for(let channel=0;channel<4;channel++)
+    assert_equals(region[(y*7+x)*4+channel],first[((y+5)*32+x+4)*4+channel]);
+}, 'Repeated native reads and absolute-coordinate subregions agree');
+test(() => {
+  const ctx=paint(canvas()); const first=ctx.getImageData(0,0,32,24);
+  ctx.putImageData(first,0,0);
+  assert_array_equals(pixels(ctx),Array.from(first.data));
+  ctx.clearRect(0,0,32,24);
+  assert_true(pixels(ctx).every(v=>v===0));
+}, 'putImageData of projected pixels is idempotent and clear remains transparent');
+promise_test(async () => {
+  const c=canvas(); const ctx=paint(c); const first=pixels(ctx);
+  const blobs=[await (await fetch(c.toDataURL('image/png'))).blob(),
+               await new Promise(resolve=>c.toBlob(resolve,'image/png'))];
+  for(const blob of blobs) {
+    assert_not_equals(blob,null);
+    const decoded=await createImageBitmap(blob);
+    const target=canvas(); const targetCtx=target.getContext('2d',{willReadFrequently:true});
+    targetCtx.drawImage(decoded,0,0);
+    assert_array_equals(pixels(targetCtx),first);
+    decoded.close();
+  }
+  assert_array_equals(pixels(ctx),first);
+}, 'Decoded PNG exports agree with readback and leave source backing unchanged');
+promise_test(async () => {
+  const off=new OffscreenCanvas(32,24); const ctx=paint(off); const first=pixels(ctx);
+  const decoded=await createImageBitmap(await off.convertToBlob({type:'image/png'}));
+  const c=canvas(); const target=c.getContext('2d',{willReadFrequently:true});
+  target.drawImage(decoded,0,0);
+  assert_array_equals(pixels(target),first); decoded.close();
+  assert_array_equals(first,pixels(paint(canvas())));
+}, 'Offscreen main-thread PNG and ordinary Canvas2D agree');
+promise_test(async () => {
+  const source=paint.toString()+';'+pixels.toString()+`;
+    onmessage=async()=>{try{
+      const off=new OffscreenCanvas(32,24); const ctx=paint(off); const first=pixels(ctx);
+      const bitmap=await createImageBitmap(await off.convertToBlob({type:'image/png'}));
+      const target=new OffscreenCanvas(32,24).getContext('2d',{willReadFrequently:true});
+      target.drawImage(bitmap,0,0); bitmap.close();
+      postMessage({first,decoded:pixels(target),repeated:pixels(ctx)});
+    }catch(error){postMessage({error:String(error)})}}`;
+  const url=URL.createObjectURL(new Blob([source],{type:'text/javascript'}));
+  const worker=new Worker(url);
+  try {
+    const result=await new Promise((resolve,reject)=>{worker.onmessage=e=>resolve(e.data);worker.onerror=reject;worker.postMessage(null)});
+    assert_false('error' in result, result.error);
+    assert_array_equals(result.first,result.repeated);
+    assert_array_equals(result.first,result.decoded);
+    assert_array_equals(result.first,pixels(paint(canvas())));
+  } finally { worker.terminate(); URL.revokeObjectURL(url); }
+}, 'Dedicated worker Offscreen readback/export/repeat agrees with window persona');
+</script>
