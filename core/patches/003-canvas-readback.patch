+// Copyright 2026 The NeAntik Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "third_party/blink/renderer/platform/graphics/neantik_canvas_readback.h"
+
+#include <utility>
+#include "third_party/blink/public/common/fingerprinting/neantik_fingerprint.h"
+#include "third_party/blink/renderer/platform/graphics/static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/graphics/unaccelerated_static_bitmap_image.h"
+#include "third_party/skia/include/core/SkColorSpace.h"
+#include "third_party/skia/include/core/SkData.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "ui/gfx/skia_span_util.h"
+
+namespace blink {
+namespace {
+bool Supported(const SkImageInfo& info) {
+  return (info.colorType() == kRGBA_8888_SkColorType ||
+          info.colorType() == kBGRA_8888_SkColorType) &&
+         (!info.colorSpace() || info.colorSpace()->isSRGB());
+}
+constexpr uint64_t kCanvasDomain = 0x43414e5641530001ULL;
+}  // namespace
+
+void ApplyNeAntikCanvasReadback(const SkPixmap& pixmap,
+                               int origin_x,
+                               int origin_y,
+                               uint64_t seed) {
+  if (!pixmap.addr() || !Supported(pixmap.info()) ||
+      (pixmap.alphaType() != kUnpremul_SkAlphaType &&
+       pixmap.alphaType() != kOpaque_SkAlphaType))
+    return;
+  auto bytes = gfx::SkPixmapToWritableSpan(pixmap);
+  const bool rgba = pixmap.colorType() == kRGBA_8888_SkColorType;
+  for (int y = 0; y < pixmap.height(); ++y) {
+    for (int x = 0; x < pixmap.width(); ++x) {
+      const size_t offset = size_t(y) * pixmap.rowBytes() + size_t(x) * 4;
+      // Preserve all partially/fully transparent values, including hidden RGB.
+      if (bytes[offset + 3] != 255)
+        continue;
+      const uint64_t position =
+          (uint64_t(uint32_t(int64_t(origin_y) + y)) << 32) |
+          uint32_t(int64_t(origin_x) + x);
+      const uint64_t bits =
+          neantik::MixFingerprintSeed(seed, kCanvasDomain, position);
+      const size_t channels[3] = {rgba ? 0u : 2u, 1u, rgba ? 2u : 0u};
+      for (size_t channel = 0; channel < 3; ++channel) {
+        uint8_t& value = bytes[offset + channels[channel]];
+        value = (value & 0xfeu) | ((bits >> channel) & 1u);
+      }
+    }
+  }
+}
+
+scoped_refptr<StaticBitmapImage> NeAntikCanvasExportSnapshot(
+    scoped_refptr<StaticBitmapImage> image) {
+  const auto* config = neantik::GetFingerprintConfig();
+  if (!config || !image)
+    return image;
+  PaintImage paint_image = image->PaintImageForCurrentFrame();
+  const SkImageInfo original_info = paint_image.GetSkImageInfo();
+  if (!Supported(original_info))
+    return image;
+  // Convert before projection so getImageData and encoded PNG see identical
+  // straight-alpha sRGB uint8 values. No original canvas backing store is used
+  // as writable memory and no random state is advanced by reading.
+  const SkImageInfo info =
+      original_info.makeColorType(kRGBA_8888_SkColorType)
+          .makeAlphaType(kUnpremul_SkAlphaType);
+  const size_t row_bytes = info.minRowBytes();
+  const size_t byte_size = info.computeByteSize(row_bytes);
+  if (SkImageInfo::ByteSizeOverflowed(byte_size))
+    return nullptr;
+  sk_sp<SkData> data = SkData::MakeUninitialized(byte_size);
+  if (!data)
+    return nullptr;
+  SkPixmap pixmap(info, data->writable_data(), row_bytes);
+  if (!paint_image.readPixels(info, pixmap.writable_addr(), row_bytes, 0, 0))
+    return nullptr;
+  ApplyNeAntikCanvasReadback(pixmap, 0, 0, config->seed);
+  auto sk_image = SkImages::RasterFromData(info, std::move(data), row_bytes);
+  if (!sk_image)
+    return nullptr;
+  return UnacceleratedStaticBitmapImage::Create(
+      std::move(sk_image), image->Orientation(), image->GetHdrMetadata());
+}
+}  // namespace blink
