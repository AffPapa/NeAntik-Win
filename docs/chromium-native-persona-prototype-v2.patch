+// Copyright 2026 The NeAntik Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "third_party/blink/renderer/platform/graphics/neantik_canvas_readback.h"
+#include <array>
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColorSpace.h"
+namespace blink {
+namespace {
+SkImageInfo Info(int w, int h, SkColorType type = kRGBA_8888_SkColorType) {
+  return SkImageInfo::Make(w, h, type, kUnpremul_SkAlphaType,
+                           SkColorSpace::MakeSRGB());
+}
+TEST(NeAntikCanvasReadbackTest, RepeatReadsAreIdempotentAndSeedsDiffer) {
+  std::array<uint8_t, 64> a;
+  a.fill(255);
+  auto b = a;
+  ApplyNeAntikCanvasReadback(SkPixmap(Info(4, 4), a.data(), 16), 0, 0, 123);
+  const auto first = a;
+  ApplyNeAntikCanvasReadback(SkPixmap(Info(4, 4), a.data(), 16), 0, 0, 123);
+  EXPECT_EQ(a, first);
+  ApplyNeAntikCanvasReadback(SkPixmap(Info(4, 4), b.data(), 16), 0, 0, 456);
+  EXPECT_NE(a, b);
+}
+TEST(NeAntikCanvasReadbackTest, SubregionMatchesWholeCanvasCoordinates) {
+  std::array<uint8_t, 64> whole;
+  whole.fill(255);
+  std::array<uint8_t, 16> region;
+  region.fill(255);
+  ApplyNeAntikCanvasReadback(SkPixmap(Info(4, 4), whole.data(), 16), 0, 0, 123);
+  ApplyNeAntikCanvasReadback(SkPixmap(Info(2, 2), region.data(), 8), 1, 1, 123);
+  for (size_t y = 0; y < 2; ++y)
+    for (size_t x = 0; x < 8; ++x)
+      EXPECT_EQ(region[y * 8 + x], whole[(y + 1) * 16 + 4 + x]);
+}
+TEST(NeAntikCanvasReadbackTest, TransparentPixelsAlphaAndPaddingUnchanged) {
+  std::array<uint8_t, 12> pixels = {123, 45, 67, 0, 89, 12, 34, 127, 91, 92, 93, 94};
+  const auto original = pixels;
+  ApplyNeAntikCanvasReadback(SkPixmap(Info(2, 1), pixels.data(), 12), -1, -1, 123);
+  EXPECT_EQ(pixels, original);
+}
+TEST(NeAntikCanvasReadbackTest, RgbaAndBgraProjectSameLogicalChannels) {
+  std::array<uint8_t, 4> rgba = {10, 20, 30, 255};
+  std::array<uint8_t, 4> bgra = {30, 20, 10, 255};
+  ApplyNeAntikCanvasReadback(SkPixmap(Info(1, 1), rgba.data(), 4), 7, 9, 123);
+  ApplyNeAntikCanvasReadback(
+      SkPixmap(Info(1, 1, kBGRA_8888_SkColorType), bgra.data(), 4), 7, 9, 123);
+  EXPECT_EQ(rgba[0], bgra[2]);
+  EXPECT_EQ(rgba[1], bgra[1]);
+  EXPECT_EQ(rgba[2], bgra[0]);
+  EXPECT_EQ(rgba[3], 255);
+}
+TEST(NeAntikCanvasReadbackTest, Float16AndPremultipliedDataAreUntouched) {
+  std::array<uint8_t, 8> pixels;
+  pixels.fill(255);
+  const auto original = pixels;
+  ApplyNeAntikCanvasReadback(
+      SkPixmap(Info(1, 1, kRGBA_F16_SkColorType), pixels.data(), 8), 0, 0, 123);
+  EXPECT_EQ(pixels, original);
+  ApplyNeAntikCanvasReadback(
+      SkPixmap(Info(1, 1).makeAlphaType(kPremul_SkAlphaType), pixels.data(), 4), 0, 0, 123);
+  EXPECT_EQ(pixels, original);
+}
+}  // namespace
+}  // namespace blink
