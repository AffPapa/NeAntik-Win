diff --git a/third_party/blink/common/fingerprinting/neantik_fingerprint.cc b/third_party/blink/common/fingerprinting/neantik_fingerprint.cc
new file mode 100644
index 0000000000..f6ac2da3bf
--- /dev/null
+++ b/third_party/blink/common/fingerprinting/neantik_fingerprint.cc
@@ -0,0 +1,165 @@
+// Copyright 2026 The NeAntik Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/fingerprinting/neantik_fingerprint.h"
+
+#include <algorithm>
+#include <array>
+#include <string_view>
+#include <utility>
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/no_destructor.h"
+#include "third_party/icu/source/i18n/unicode/timezone.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+
+namespace blink::neantik {
+namespace {
+
+bool IsDecimal(std::string_view value) {
+  if (value.empty() || value.size() > 20) {
+    return false;
+  }
+  for (char c : value) {
+    if (c < '0' || c > '9') {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+std::optional<FingerprintConfig> ParseFingerprintConfig(
+    const base::CommandLine& command_line,
+    std::string* error) {
+  CHECK(error);
+  error->clear();
+  for (const auto& [name, ignored_value] : command_line.GetSwitches()) {
+    if (base::StartsWith(name, "neantik-", base::CompareCase::SENSITIVE) &&
+        name != kSeedSwitch && name != kHardwareConcurrencySwitch &&
+        name != kDeviceMemorySwitch && name != kTimeZoneSwitch &&
+        name != kCoreInfoSwitch) {
+      *error = "Unknown NeAntik switch";
+      return std::nullopt;
+    }
+  }
+  if (command_line.HasSwitch(kCoreInfoSwitch) &&
+      command_line.GetSwitchValuePath(kCoreInfoSwitch).empty()) {
+    *error = "NeAntik core-info requires an output path";
+    return std::nullopt;
+  }
+  if (!command_line.HasSwitch(kSeedSwitch)) {
+    if (command_line.HasSwitch(kHardwareConcurrencySwitch) ||
+        command_line.HasSwitch(kDeviceMemorySwitch) ||
+        command_line.HasSwitch(kTimeZoneSwitch)) {
+      *error = "NeAntik hardware overrides require a fingerprint seed";
+    }
+    return std::nullopt;
+  }
+  FingerprintConfig config;
+  const std::string seed = command_line.GetSwitchValueASCII(kSeedSwitch);
+  if (!IsDecimal(seed) || !base::StringToUint64(seed, &config.seed) ||
+      config.seed == 0) {
+    *error = "NeAntik fingerprint seed must be a nonzero uint64 decimal";
+    return std::nullopt;
+  }
+  if (command_line.HasSwitch(kHardwareConcurrencySwitch)) {
+    const std::string cpu =
+        command_line.GetSwitchValueASCII(kHardwareConcurrencySwitch);
+    if (!IsDecimal(cpu) ||
+        !base::StringToUint(cpu, &config.hardware_concurrency) ||
+        config.hardware_concurrency < 1 || config.hardware_concurrency > 64) {
+      *error = "NeAntik hardware concurrency must be in [1,64]";
+      return std::nullopt;
+    }
+  }
+  if (command_line.HasSwitch(kDeviceMemorySwitch)) {
+    const std::string memory =
+        command_line.GetSwitchValueASCII(kDeviceMemorySwitch);
+    // Match exact Windows155 stock device-memory quantization limits.
+    constexpr std::array<std::pair<std::string_view, float>, 5> kValues = {{
+        {"2", 2.0f}, {"4", 4.0f}, {"8", 8.0f}, {"16", 16.0f},
+        {"32", 32.0f}}};
+    bool valid = false;
+    for (const auto& [text, value] : kValues) {
+      if (memory == text) {
+        config.device_memory = value;
+        valid = true;
+        break;
+      }
+    }
+    if (!valid) {
+      *error = "NeAntik Windows155 device memory must be one of 2,4,8,16,32";
+      return std::nullopt;
+    }
+  }
+  if (command_line.HasSwitch(kTimeZoneSwitch)) {
+    config.time_zone = command_line.GetSwitchValueASCII(kTimeZoneSwitch);
+    if (config.time_zone.empty() || config.time_zone.size() > 128) {
+      *error = "NeAntik timezone must be a nonempty IANA identifier";
+      return std::nullopt;
+    }
+    for (char c : config.time_zone) {
+      if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+            (c >= '0' && c <= '9') || c == '/' || c == '_' ||
+            c == '-' || c == '+')) {
+        *error = "Malformed NeAntik IANA timezone";
+        return std::nullopt;
+      }
+    }
+  }
+  return config;
+}
+
+bool ValidateFingerprintTimeZone(const FingerprintConfig& config,
+                                 std::string* error) {
+  CHECK(error);
+  error->clear();
+  if (config.time_zone.empty()) {
+    return true;
+  }
+  UErrorCode status = U_ZERO_ERROR;
+  UBool is_system_id = false;
+  icu::UnicodeString canonical;
+  icu::TimeZone::getCanonicalID(
+      icu::UnicodeString(config.time_zone.c_str(), -1, US_INV),
+      canonical, is_system_id, status);
+  if (U_FAILURE(status) || !is_system_id) {
+    *error = "Unknown NeAntik IANA timezone";
+    return false;
+  }
+  return true;
+}
+
+const FingerprintConfig* GetFingerprintConfig() {
+  static const base::NoDestructor<std::optional<FingerprintConfig>> config([] {
+    std::string error;
+    auto parsed = ParseFingerprintConfig(
+        *base::CommandLine::ForCurrentProcess(), &error);
+    CHECK(error.empty()) << error;
+    return parsed;
+  }());
+  return config->has_value() ? &config->value() : nullptr;
+}
+
+unsigned BoundHardwareConcurrency(unsigned requested, unsigned stock) {
+  return std::min(requested, stock);
+}
+
+float BoundDeviceMemory(float requested, float stock) {
+  return std::min(requested, stock);
+}
+
+uint64_t MixFingerprintSeed(uint64_t seed, uint64_t domain, uint64_t value) {
+  uint64_t mixed = seed ^ domain ^ (value + UINT64_C(0x9e3779b97f4a7c15));
+  mixed = (mixed ^ (mixed >> 30)) * UINT64_C(0xbf58476d1ce4e5b9);
+  mixed = (mixed ^ (mixed >> 27)) * UINT64_C(0x94d049bb133111eb);
+  return mixed ^ (mixed >> 31);
+}
+
+}  // namespace blink::neantik
