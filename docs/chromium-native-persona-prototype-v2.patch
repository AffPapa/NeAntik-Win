diff --git a/third_party/blink/web_tests/http/tests/neantik/timezone.html b/third_party/blink/web_tests/http/tests/neantik/timezone.html
new file mode 100644
index 0000000000..6368f7f50b
--- /dev/null
+++ b/third_party/blink/web_tests/http/tests/neantik/timezone.html
@@ -0,0 +1,66 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>NeAntik native timezone parity</title>
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<script src="resources/timezone-surface.js"></script>
+<body>
+<script>
+// Run with actual patched test driver flags --neantik-fingerprint-seed=123456
+// --neantik-timezone=Europe/Berlin. Stock drivers must fail this suite.
+const expected = {zone:'Europe/Berlin',winter:-60,summer:-120,
+  beforeDST:-60,afterDST:-120,formatted:'13:00'};
+const early = timezoneSurface();
+function same(actual) {
+  for(const key of Object.keys(expected)) assert_equals(actual[key],expected[key],key);
+}
+test(()=>same(early),'First script observes configured native timezone and DST');
+test(()=>same(timezoneSurface()),'Repeated Date and Intl reads agree');
+promise_test(async t=>{
+  const f=document.createElement('iframe');
+  t.add_cleanup(()=>f.remove());
+  const result=new Promise(resolve=>window.addEventListener('message',function receive(e){
+    if(e.source===f.contentWindow){window.removeEventListener('message',receive);resolve(e.data);}
+  }));
+  f.src='resources/timezone-frame.html';document.body.append(f);
+  same(await result);
+},'Same-origin iframe timezone agrees');
+promise_test(async t=>{
+  const f=document.createElement('iframe');
+  t.add_cleanup(()=>f.remove());
+  const result=new Promise(resolve=>window.addEventListener('message',function receive(e){
+    if(e.source===f.contentWindow){window.removeEventListener('message',receive);resolve(e.data);}
+  }));
+  const u=new URL('resources/timezone-frame.html',location.href);
+  u.hostname=location.hostname==='localhost'?'127.0.0.1':'localhost';
+  f.src=u.href;document.body.append(f);same(await result);
+},'Cross-origin iframe timezone agrees');
+promise_test(async t=>{
+  const w=new Worker('resources/timezone-worker.js');t.add_cleanup(()=>w.terminate());
+  same(await new Promise((resolve,reject)=>{w.onmessage=e=>resolve(e.data);w.onerror=reject;}));
+},'Dedicated worker timezone agrees');
+promise_test(async t=>{
+  const w=new SharedWorker('resources/timezone-shared.js');t.add_cleanup(()=>w.port.close());
+  same(await new Promise((resolve,reject)=>{w.port.onmessage=e=>resolve(e.data);w.onerror=reject;w.port.start();}));
+},'Shared worker timezone agrees');
+promise_test(async t=>{
+  assert_true('serviceWorker' in navigator,'ServiceWorker is required coverage');
+  const reg=await navigator.serviceWorker.register('resources/timezone-service.js',{
+    scope:'resources/'});
+  t.add_cleanup(()=>reg.unregister());
+  // This document is outside resources/ scope; navigator.serviceWorker.ready
+  // would wait forever. Wait for this registration's activation explicitly.
+  let active=reg.active;
+  if(!active){
+    active=reg.installing||reg.waiting;
+    assert_true(!!active,'installing service worker');
+    await new Promise(resolve=>{
+      if(active.state==='activated')return resolve();
+      active.addEventListener('statechange',()=>{if(active.state==='activated')resolve();});
+    });
+  }
+  const channel=new MessageChannel();t.add_cleanup(()=>channel.port1.close());
+  const result=new Promise(resolve=>channel.port1.onmessage=e=>resolve(e.data));
+  active.postMessage('read',[channel.port2]);same(await result);
+},'Service worker timezone agrees');
+</script>
